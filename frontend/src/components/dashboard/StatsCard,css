.stats-card{

background:#1E293B;

padding:22px;

border-radius:18px;

display:flex;

align-items:center;

gap:20px;

box-shadow:0 10px 25px rgba(0,0,0,.25);

transition:.3s;

}

.stats-card:hover{

transform:translateY(-5px);

}

.stats-icon{

width:65px;

height:65px;

display:flex;

align-items:center;

justify-content:center;

font-size:28px;

border-radius:15px;

color:white;

}

.stats-content h4{

font-size:14px;

color:#94A3B8;

margin-bottom:8px;

}

.stats-content h2{

font-size:28px;

color:white;

margin-bottom:6px;

}

.growth{

color:#22C55E;

font-size:13px;

font-weight:600;

}